#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt {
    quick_tap_ms = <200>;
    flavor = "balanced";
};

&mt {
    quick_tap_ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        mt_left: mt_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 40 41 30 32 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 42 43>;
            hold-trigger-on-release;
            require-prior-idle-ms = <149>;
        };

        mt_right: mt_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &none  &kp Q                    &kp W                &kp E                  &kp R             &kp T        &kp Y            &kp U              &kp I              &kp O                  &kp P                         &none
  &none  &mt_left LEFT_COMMAND A  &mt_left LEFT_ALT S  &mt_left LEFT_SHIFT D  &mt_left LCTRL F  &kp G        &kp H            &mt_right RCTRL J  &mt_right RSHFT K  &mt_right RIGHT_ALT L  &mt_right RIGHT_COMMAND SEMI  &none
  &none  &kp Z                    &kp X                &kp C                  &kp V             &kp B        &kp N            &kp M              &kp COMMA          &kp DOT                &kp SLASH                     &none
                                  &none                &kp ESCAPE             &lt 2 SPACE       &lt 1 RET    &lt 1 BACKSPACE  &lt 2 SPACE        &kp GRAVE          &none
            >;
        };

        lower_layer {
            bindings = <
  &none  &kp NUMBER_1                 &kp NUMBER_2         &kp NUMBER_3          &kp NUMBER_4                 &kp N5                  &kp NUMBER_6           &kp N7                      &kp N8                &kp N9                    &kp N0                                &none
  &none  &mt_left LEFT_COMMAND EQUAL  &mt_left LALT SLASH  &mt_left LSHFT ASTRK  &mt_left LEFT_CONTROL MINUS  &kp PLUS                &kp PERCENT            &mt_right RCTRL UNDERSCORE  &mt_right RSHFT HASH  &mt_right RALT BACKSLASH  &mt_right RIGHT_COMMAND LEFT_BRACKET  &none
  &none  &kp DOUBLE_QUOTES            &kp LESS_THAN        &kp LEFT_BRACE        &kp LEFT_BRACKET             &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET           &kp RIGHT_BRACE       &kp GREATER_THAN          &kp SQT                               &none
                                      &trans               &kp TAB               &kp SPACE                    &kp RET                 &kp BACKSPACE          &kp SPACE                   &kp LS(TAB)           &trans
            >;
        };

        raise_layer {
            bindings = <
  &none  &kp CAPS          &kp F1                &kp F2                  &kp F3                    &kp F4     &kp C_PP              &kp C_VOL_DN    &kp C_VOL_UP  &kp C_MUTE               &kp C_BRI_INC        &none
  &none  &kp LEFT_COMMAND  &mt_left LEFT_ALT F5  &mt_left LEFT_SHIFT F6  &mt_left LEFT_CONTROL F7  &kp F8     &kp LEFT              &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW          &kp C_BRI_DEC        &none
  &none  &kp PRINTSCREEN   &kp F9                &kp F10                 &kp F11                   &kp F12    &mt_right RCTRL HOME  &kp PAGE_DOWN   &kp PG_UP     &mt_right RIGHT_ALT END  &kp LC(PRINTSCREEN)  &none
                           &trans                &mo 5                   &kp LG(SPACE)             &none      &none                 &kp RG(SPACE)   &mo 5         &trans
            >;
        };

        gaming {
            bindings = <
  &kp CAPSLOCK  &kp Q  &kp W     &kp E    &kp R      &kp T        &kp Y            &kp U      &kp I      &kp O          &kp P     &kp LEFT_BRACKET
  &kp LSHIFT    &kp A  &kp S     &kp D    &kp F      &kp G        &kp H            &kp J      &kp K      &kp L          &kp SEMI  &kp RSHIFT
  &kp LCTRL     &kp Z  &kp X     &kp C    &kp V      &kp B        &kp N            &kp M      &kp COMMA  &kp DOT        &kp FSLH  &kp RCTRL
                       &kp LALT  &kp TAB  &kp SPACE  &lt 4 RET    &lt 4 BACKSPACE  &kp SPACE  &none      &kp RIGHT_ALT
            >;
        };

        lower_gaming {
            bindings = <
  &kp ESCAPE  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F5      &kp NUMBER_6  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp NUMBER_0    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F8      &kp M         &kp I         &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &to 0         &trans          &trans  &to 0   &trans  &trans
            >;
        };

        connection {
            bindings = <
  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &trans      &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
  &trans      &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                            &trans        &trans        &trans        &to 3           &trans        &trans        &trans        &trans
            >;
        };
    };
};
