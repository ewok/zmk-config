#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt {
    quick_tap_ms = <200>;
    flavor = "balanced";
};

&mt {
    quick_tap_ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        mt_left: mt_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 40 41 30 32 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 42 43>;
            hold-trigger-on-release;
            require-prior-idle-ms = <149>;
        };

        mt_right: mt_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        fs {
            bindings = <&mo 3>;
            key-positions = <36 43>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
            layers = <0>;
        };

        land {
            bindings = <&kp LG(SPACE)>;
            key-positions = <38 41>;
            layers = <0>;
            timeout-ms = <1500>;
        };

        exc {
            bindings = <&kp EXCL>;
            key-positions = <2 3>;
            layers = <1>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <3 4>;
            layers = <1>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <4 5>;
            layers = <1>;
        };

        doll {
            bindings = <&kp DOLLAR>;
            key-positions = <6 7>;
            layers = <1>;
        };

        amp {
            bindings = <&kp AMPS>;
            key-positions = <7 8>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp LCMD   &kp Q  &kp W         &kp E      &kp R             &kp T        &kp Y            &kp U            &kp I        &kp O    &kp P          &mt RCMD LBKT
  &kp LCTRL  &kp A  &kp S         &kp D      &kp F             &kp G        &kp H            &kp J            &kp K        &kp L    &kp SEMICOLON  &mt RCTRL SQT
  &kp LALT   &kp Z  &kp X         &kp C      &kp V             &kp B        &kp N            &kp M            &kp COMMA    &kp DOT  &kp SLASH      &mt RALT DQT
                    &lt 6 ESCAPE  &lt 2 TAB  &mt LSHIFT SPACE  &lt 1 RET    &lt 1 BACKSPACE  &mt RSHFT SPACE  &lt 2 GRAVE  &mo 6
            >;
        };

        sym {
            bindings = <
  &kp LCMD   &kp NUMBER_1       &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4  &kp N5                  &kp NUMBER_6   &kp N7     &kp N8     &kp N9            &kp N0     &kp RCMD
  &kp LCTRL  &kp EQUAL          &kp SLASH      &kp ASTRK     &kp MINUS     &kp PLUS                &kp PERCENT    &kp UNDER  &kp HASH   &kp BACKSLASH     &kp COLON  &kp RCTRL
  &kp LALT   &kp DOUBLE_QUOTES  &kp LESS_THAN  &kp LBRC      &kp LBKT      &kp LEFT_PARENTHESIS    &kp RPAR       &kp RBKT   &kp RBRC   &kp GREATER_THAN  &kp SQT    &kp RALT
                                &trans         &kp ESCAPE    &trans        &kp RET                 &kp BACKSPACE  &trans     &kp TILDE  &trans
            >;
        };

        nav {
            bindings = <
  &kp LCMD   &none            &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &mkp MCLK    &kp C_PP    &kp C_VOL_DN    &kp C_VOL_UP  &kp C_MUTE       &kp C_BRI_INC        &kp RCMD
  &kp LCTRL  &none            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none        &kp LEFT    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp C_BRI_DEC        &kp RCTRL
  &kp LALT   &kp PRINTSCREEN  &none           &msc SCRL_DOWN  &msc SCRL_UP     &kp CAPS     &kp HOME    &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp LC(PRINTSCREEN)  &kp RIGHT_ALT
                              &trans          &trans          &trans           &trans       &kp DELETE  &trans          &trans        &trans
            >;
        };

        fs {
            bindings = <
  &kp LGUI   &trans  &kp F1  &kp F2   &kp F3   &kp F4     &kp SYSREQ  &kp LC(LA(DELETE))  &trans  &trans  &trans  &kp RGUI
  &kp LCTRL  &trans  &kp F5  &kp F6   &kp F7   &kp F8     &trans      &trans              &trans  &trans  &trans  &kp RCTRL
  &kp LALT   &trans  &kp F9  &kp F10  &kp F11  &kp F12    &trans      &trans              &trans  &trans  &trans  &kp RALT
                     &trans  &trans   &trans   &trans     &trans      &trans              &trans  &trans
            >;
        };

        gaming {
            bindings = <
  &kp CAPSLOCK  &kp Q  &kp W         &kp E    &kp R      &kp T        &kp Y            &kp U      &kp I      &kp O          &kp P     &kp LEFT_BRACKET
  &kp LSHIFT    &kp A  &kp S         &kp D    &kp F      &kp G        &kp H            &kp J      &kp K      &kp L          &kp SEMI  &kp RSHIFT
  &kp LCTRL     &kp Z  &kp X         &kp C    &kp V      &kp B        &kp N            &kp M      &kp COMMA  &kp DOT        &kp FSLH  &kp RCTRL
                       &kp LEFT_ALT  &kp TAB  &kp SPACE  &lt 5 RET    &lt 5 BACKSPACE  &kp SPACE  &none      &kp RIGHT_ALT
            >;
        };

        lower_gaming {
            bindings = <
  &kp ESCAPE  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F5      &kp NUMBER_6  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp NUMBER_0    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F8      &kp M         &kp I         &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                            &to 0         &trans        &trans        &trans          &trans  &trans  &trans  &to 0
            >;
        };

        connection {
            bindings = <
  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &trans      &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
  &trans      &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                            &trans        &trans        &trans        &to 4           &to 4         &trans        &trans        &trans
            >;
        };
    };
};
