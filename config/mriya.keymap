#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 40 41 30 32 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 42 43 36 37 38 39>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 43>;
            hold-trigger-on-release;
        };

        lt_tap: lt_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        land {
            bindings = <&kp LG(SPACE)>;
            key-positions = <38 41>;
            layers = <0>;
            timeout-ms = <1500>;
        };

        exc {
            bindings = <&kp EXCL>;
            key-positions = <2 1>;
            layers = <1>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <3 2>;
            layers = <1>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <4 5>;
            layers = <1>;
        };

        doll {
            bindings = <&kp DOLLAR>;
            key-positions = <16 17>;
            layers = <1>;
        };

        amp {
            bindings = <&kp AMPS>;
            key-positions = <3 4>;
            layers = <1>;
        };

        rconnect {
            bindings = <&mo 5>;
            key-positions = <40 43>;
            timeout-ms = <1500>;
            layers = <0>;
        };

        lconnect {
            bindings = <&mo 5>;
            key-positions = <36 39>;
            timeout-ms = <1500>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp LCMD   &kp Q  &kp W        &kp E          &kp R              &kp T             &kp Y                 &kp U             &kp I          &kp O      &kp P          &hmr RCMD LBKT
  &kp LCTRL  &kp A  &kp S        &kp D          &kp F              &kp G             &kp H                 &kp J             &kp K          &kp L      &kp SEMICOLON  &hmr RCTRL SQT
  &kp LALT   &kp Z  &kp X        &kp C          &kp V              &kp B             &kp N                 &kp M             &kp COMMA      &kp DOT    &kp SLASH      &hmr RALT DQT
                    &kp LS(TAB)  &lt_tap 2 TAB  &hml LSHIFT SPACE  &lt_hold 1 RET    &lt_hold 1 BACKSPACE  &hmr RSHFT SPACE  &lt_tap 2 F12  &kp GRAVE
            >;
        };

        sym {
            bindings = <
  &kp LCMD   &kp N1     &kp N2    &kp N3        &kp N4     &kp N5        &kp PERCENT            &kp UNDER         &kp HASH         &kp BACKSLASH     &kp PIPE           &kp RCMD
  &kp LCTRL  &kp N6     &kp N7    &kp N8        &kp N9     &kp N0        &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET  &kp LEFT_BRACE   &kp LESS_THAN     &kp APOS           &kp RCTRL
  &kp LALT   &kp EQUAL  &kp FSLH  &kp ASTERISK  &kp MINUS  &kp PLUS      &kp RIGHT_PARENTHESIS  &kp RBKT          &kp RIGHT_BRACE  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp RALT
                        &trans    &kp PIPE      &trans     &kp ESCAPE    &kp BACKSPACE          &trans            &kp GRAVE        &trans
            >;
        };

        nav {
            bindings = <
  &kp LCMD          &kp F1           &kp F2  &kp F3  &kp F4   &kp F5        &kp C_MUTE  &kp C_VOL_DN    &kp C_VOL_UP  &kp C_BRI_DN     &kp C_BRI_UP         &kp RCMD
  &mt LCTRL ESCAPE  &kp F6           &kp F7  &kp F8  &kp F9   &kp F10       &kp LEFT    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp CAPS             &kp RCTRL
  &kp LALT          &kp PRINTSCREEN  &trans  &trans  &kp F11  &kp F12       &kp HOME    &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp LC(PRINTSCREEN)  &kp RIGHT_ALT
                                     &trans  &trans  &trans   &kp ESCAPE    &kp DELETE  &trans          &kp TILDE     &trans
            >;
        };

        gaming {
            bindings = <
  &kp CAPSLOCK  &kp Q  &kp W         &kp E    &kp R      &kp T        &kp Y            &kp U      &kp I      &kp O          &kp P     &kp LEFT_BRACKET
  &kp LSHIFT    &kp A  &kp S         &kp D    &kp F      &kp G        &kp H            &kp J      &kp K      &kp L          &kp SEMI  &kp RSHIFT
  &kp LCTRL     &kp Z  &kp X         &kp C    &kp V      &kp B        &kp N            &kp M      &kp COMMA  &kp DOT        &kp FSLH  &kp RCTRL
                       &kp LEFT_ALT  &kp TAB  &kp SPACE  &lt 4 RET    &lt 4 BACKSPACE  &kp SPACE  &none      &kp RIGHT_ALT
            >;
        };

        lower_gaming {
            bindings = <
  &kp ESCAPE  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F5      &kp NUMBER_6  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp NUMBER_0    &trans  &trans  &trans  &trans  &trans  &trans
  &kp F8      &kp M         &kp I         &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                            &to 0         &trans        &trans        &trans          &trans  &trans  &trans  &to 0
            >;
        };

        connection {
            bindings = <
  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans
  &trans  &trans        &trans        &trans        &bt BT_CLR    &trans          &trans        &bt BT_CLR    &trans        &trans        &trans        &trans
  &trans  &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                        &trans        &trans        &to 3         &trans          &trans        &to 3         &trans        &trans
            >;
        };
    };
};
